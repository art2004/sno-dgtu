# Пример секретов. Скопируйте в .streamlit/secrets.toml (локально) или вставьте
# содержимое в Streamlit Community Cloud → App settings → Secrets.
# Файл .streamlit/secrets.toml НЕ коммитьте (он в .gitignore).

# Строка подключения Neon (Dashboard → Connect). Если не задана — локальная SQLite data/sno.db
DATABASE_URL = "postgresql://USER:PASSWORD@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Первый администратор создаётся при первом запуске, если в базе ещё нет админа
ADMIN_LOGIN = "admin"
ADMIN_PASSWORD = "придумайте-надёжный-пароль"
